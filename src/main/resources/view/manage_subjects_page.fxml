<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" stylesheets="@../css/manage_subjects_page.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.subject.ManageSubjectPageController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar">
            <padding>
                <Insets bottom="25.0" left="20.0" right="20.0" top="28.0" />
            </padding>

            <children>
                <Label styleClass="sidebar-logo" text="StudentHub" />
                <Label styleClass="sidebar-subtitle" text="ADMIN PANEL" />

                <VBox spacing="8.0">
                    <padding>
                        <Insets top="42.0" />
                    </padding>
                    <children>
                        <Button onAction="#dashboardOnAction" styleClass="menu-button" text="⌂   Dashboard" />
                        <Button onAction="#addStudentOnAction" styleClass="menu-button" text="👨‍🎓   Add Student" />
                        <Button onAction="#updateStudentOnAction" styleClass="menu-button" text="✎   Update Student" />
                        <Button onAction="#deleteStudentOnAction" styleClass="menu-button" text="⌫   Delete Student" />
                        <Button onAction="#viewStudentsOnAction" styleClass="menu-button" text="☷   View Students" />
                        <Button onAction="#addMarksOnAction" styleClass="menu-button" text="★   Add Marks" />
                        <Button onAction="#manageSubjectsOnAction" styleClass="menu-button, active-menu" text="▣   Manage Subjects" />
                    </children>
                </VBox>

                <AnchorPane VBox.vgrow="ALWAYS" />

                <Button onAction="#logoutOnAction" styleClass="logout-button" text="⇥   Log Out" />
            </children>
        </VBox>
    </left>

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="top-header">
            <padding>
                <Insets left="35.0" right="35.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="header-title" text="Manage Subjects" />
                        <Label styleClass="header-description" text="Create, configure, and maintain curriculum subjects and credit values." />
                    </children>
                </VBox>

                <AnchorPane HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER" prefHeight="45.0" prefWidth="45.0" styleClass="profile-circle">
                    <children>
                        <Label styleClass="profile-letter" text="A" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <HBox spacing="20.0" styleClass="content-area">
            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <children>
                <!-- LEFT FORM CARD -->
                <VBox prefWidth="380.0" spacing="16.0" styleClass="card-box">
                    <padding>
                        <Insets bottom="24.0" left="22.0" right="22.0" top="22.0" />
                    </padding>

                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="section-title" text="Subject Information" />
                                <Label styleClass="section-subtitle" text="Fill the form or click a row in the table to edit." />
                            </children>
                        </VBox>

                        <!-- Subject ID -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="form-label" text="Subject ID *" />
                                <HBox spacing="8.0">
                                    <children>
                                        <TextField fx:id="txtSubjectId" prefHeight="38.0" promptText="e.g. SUB-001 or SUB-OOP" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <Button onAction="#generateIdOnAction" prefHeight="38.0" styleClass="action-btn-secondary" text="Auto ID" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Subject Name -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="form-label" text="Subject Name *" />
                                <TextField fx:id="txtSubjectName" prefHeight="38.0" promptText="e.g. Object Oriented Programming" styleClass="input-field" />
                            </children>
                        </VBox>

                        <!-- Credit Hours -->
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="form-label" text="Credit Hours *" />
                                <ComboBox fx:id="cmbCreditHours" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Select credits" styleClass="combo-box" />
                            </children>
                        </VBox>

                        <AnchorPane VBox.vgrow="ALWAYS" />

                        <!-- Action Buttons -->
                        <VBox spacing="10.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#saveSubjectOnAction" prefHeight="40.0" styleClass="btn-save" text="＋ Add Subject" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#updateSubjectOnAction" prefHeight="40.0" styleClass="btn-update" text="✎ Update" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#deleteSubjectOnAction" prefHeight="40.0" styleClass="btn-delete" text="🗑 Delete" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#clearOnAction" prefHeight="40.0" styleClass="btn-clear" text="↻ Clear" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- RIGHT TABLE CARD -->
                <VBox spacing="14.0" styleClass="card-box" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="18.0" />
                    </padding>

                    <children>
                        <!-- Table Top Toolbar -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="280.0" promptText="Search Subject ID or Name..." styleClass="input-field" />
                                <Button onAction="#refreshTableOnAction" prefHeight="38.0" styleClass="action-btn-secondary" text="⟳ Refresh" />
                                <AnchorPane HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblSubjectCount" styleClass="count-badge" text="Total: 0 Subjects" />
                            </children>
                        </HBox>

                        <!-- Table -->
                        <TableView fx:id="tblSubjects" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSubjectId" prefWidth="120.0" text="Subject ID" />
                                <TableColumn fx:id="colSubjectName" prefWidth="250.0" text="Subject Name" />
                                <TableColumn fx:id="colCreditHours" prefWidth="85.0" text="Credits" />
                                <TableColumn fx:id="colCreatedAt" prefWidth="140.0" text="Created At" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>

</BorderPane>
