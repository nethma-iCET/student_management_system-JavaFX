<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" stylesheets="@../css/view_student_page.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.student.ViewStudentPageController">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="240.0" styleClass="sidebar">
            <padding>
                <Insets bottom="25.0" left="20.0" right="20.0" top="28.0" />
            </padding>

            <children>
                <Label styleClass="sidebar-logo" text="StudentHub" />
                <Label styleClass="sidebar-subtitle" text="ADMIN PANEL" />

                <VBox spacing="8.0">
                    <padding>
                        <Insets top="42.0" />
                    </padding>
                    <children>
                        <Button onAction="#dashboardOnAction" styleClass="menu-button" text="⌂   Dashboard" />
                        <Button onAction="#addStudentOnAction" styleClass="menu-button" text="👨‍🎓   Add Student" />
                        <Button onAction="#updateStudentOnAction" styleClass="menu-button" text="✎   Update Student" />
                        <Button onAction="#deleteStudentOnAction" styleClass="menu-button" text="⌫   Delete Student" />
                        <Button onAction="#viewStudentsOnAction" styleClass="menu-button, active-menu" text="☷   View Students" />
                        <Button onAction="#addMarksOnAction" styleClass="menu-button" text="★   Add Marks" />
                        <Button onAction="#manageSubjectsOnAction" styleClass="menu-button" text="▣   Manage Subjects" />
                    </children>
                </VBox>

                <AnchorPane VBox.vgrow="ALWAYS" />

                <Button onAction="#logoutOnAction" styleClass="logout-button" text="⇥   Log Out" />
            </children>
        </VBox>
    </left>

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" styleClass="top-header">
            <padding>
                <Insets left="35.0" right="35.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="header-title" text="Registered Students" />
                        <Label styleClass="header-description" text="Browse student records and filter dynamically by batch or lecture mode." />
                    </children>
                </VBox>

                <AnchorPane HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER" prefHeight="48.0" prefWidth="48.0" styleClass="profile-circle">
                    <children>
                        <Label styleClass="profile-letter" text="A" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="16.0" styleClass="content-area">
            <padding>
                <Insets bottom="25.0" left="35.0" right="35.0" top="22.0" />
            </padding>

            <children>
                <!-- FILTER & SEARCH BAR -->
                <VBox spacing="10.0" styleClass="filter-card">
                    <padding>
                        <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <!-- Search Input -->
                                <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="290.0" promptText="Search ID, Name, NIC, or Email..." styleClass="input-field" />

                                <!-- Batch Filter Dropdown -->
                                <ComboBox fx:id="cmbFilterBatch" prefHeight="40.0" prefWidth="150.0" promptText="All Batches" styleClass="combo-box" />

                                <!-- Lecture Mode Filter Dropdown -->
                                <ComboBox fx:id="cmbFilterMode" prefHeight="40.0" prefWidth="145.0" promptText="All Modes" styleClass="combo-box" />

                                <!-- Reset Filter Button -->
                                <Button onAction="#resetFilterOnAction" styleClass="reset-button" text="↻ Reset" />

                                <!-- Refresh from DB Button -->
                                <Button onAction="#refreshTableOnAction" styleClass="refresh-button" text="⟳ Refresh" />

                                <AnchorPane HBox.hgrow="ALWAYS" />

                                <!-- Student Counter Badge -->
                                <Label fx:id="lblStudentCount" styleClass="count-badge" text="Total: 0 Students" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- TABLE SECTION -->
                <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                    <children>
                        <TableView fx:id="tblStudents" prefHeight="400.0" styleClass="student-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colStudentId" prefWidth="110.0" text="Student ID" />
                                <TableColumn fx:id="colStudentName" prefWidth="160.0" text="Student Name" />
                                <TableColumn fx:id="colNic" prefWidth="115.0" text="NIC Number" />
                                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email Address" />
                                <TableColumn fx:id="colBirthday" prefWidth="100.0" text="Date of Birth" />
                                <TableColumn fx:id="colBatch" prefWidth="85.0" text="Batch" />
                                <TableColumn fx:id="colLectureMode" prefWidth="75.0" text="Mode" />
                                <TableColumn fx:id="colAddress" prefWidth="180.0" text="Address" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
